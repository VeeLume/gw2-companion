{
  "version": "2.0.0",
  "tasks": [
    // gw2-api tests and the endpoint CLI live in the gw2-api repo (../gw2-api).
    {
      "label": "test: gw2-db",
      "type": "shell",
      "command": "cargo test -p gw2-db",
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": "$rustc"
    },
    {
      "label": "test: all",
      "type": "shell",
      "command": "cargo test",
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": "$rustc"
    }
  ]
}
